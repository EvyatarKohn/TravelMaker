<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:orientation="horizontal"
    android:background="@drawable/surface_card" android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical" android:padding="16dp" android:minHeight="88dp"
    android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/product_sans_bold" android:textColor="@color/ink" android:textSize="20sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="@string/favorites_open_weather"
            android:textColor="@color/accent_dark" android:textSize="14sp" />
    </LinearLayout>
    <ImageButton android:id="@+id/remove_favorite" android:layout_width="48dp" android:layout_height="48dp"
        android:padding="14dp" android:src="@drawable/ic_trash_can" app:tint="@color/ink_secondary"
        android:background="?attr/selectableItemBackgroundBorderless" />
</LinearLayout>
