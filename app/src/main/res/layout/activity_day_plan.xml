<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas">
    <Button android:id="@+id/back" style="@style/TravelButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/results_back" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/plan_title" android:textColor="@color/ink" android:textSize="30sp" android:fontFamily="@font/product_sans_bold" android:accessibilityHeading="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/plan_subtitle" android:textColor="@color/ink_secondary" android:textSize="16sp" />
            <Button android:id="@+id/date" style="@style/TravelButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/plan_date" />
            <EditText android:id="@+id/notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp" android:padding="16dp" android:gravity="top" android:background="@drawable/dashboard_card" android:hint="@string/plan_notes" android:textColor="@color/ink" android:textColorHint="@color/ink_secondary" android:inputType="textCapSentences|textMultiLine" android:maxLength="2000" android:importantForAutofill="no" />
            <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="32dp" android:text="@string/plan_empty" android:textColor="@color/ink_secondary" android:textSize="18sp" android:gravity="center" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/stops" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:nestedScrollingEnabled="false" />
            <Button android:id="@+id/share" style="@style/TravelButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/plan_share" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/plan_local" android:textColor="@color/ink_secondary" android:textSize="12sp" android:gravity="center" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
